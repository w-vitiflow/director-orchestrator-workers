+# Sentinel distinguishing "no acceptance supplied" (None) from "supplied but
+# invalid JSON" (this sentinel) so `_cmd_create` can exit 2 on a parse error.
+_ACCEPTANCE_PARSE_ERROR = object()
+
+
+def _parse_acceptance(args: argparse.Namespace) -> Optional[dict]:
+    """Resolve the ground-truth acceptance criteria for ``kanban create``.
+
+    Precedence: ``--acceptance-file`` > ``--acceptance`` > None. Returns a
+    dict (validated to contain at least ``intent``) or ``None`` when neither
+    flag is given. On invalid input returns ``_ACCEPTANCE_PARSE_ERROR`` so the
+    caller can exit non-zero (it carries its own structured message for stderr
+    via ``print`` inside).
+    """
+    raw = getattr(args, "acceptance", None)
+    file = getattr(args, "acceptance_file", None)
+    source = "--acceptance"
+    if file:
+        source = "--acceptance-file " + file
+        try:
+            with open(file, "r", encoding="utf-8") as fh:
+                raw = fh.read()
+        except OSError as exc:
+            print(f"kanban: {source}: {exc}", file=sys.stderr)
+            return _ACCEPTANCE_PARSE_ERROR
+    if not raw or not str(raw).strip():
+        return None
+    try:
+        data = json.loads(raw)
+    except (ValueError, TypeError) as exc:
+        print(
+            f"kanban: {source}: invalid JSON: {exc}",
+            file=sys.stderr,
+        )
+        return _ACCEPTANCE_PARSE_ERROR
+    if not isinstance(data, dict) or not data.get("intent"):
+        print(
+            f"kanban: {source}: acceptance must be a JSON object with a "
+            'non-empty "intent" (e.g. {"intent":"...","checks":[...]})',
+            file=sys.stderr,
+        )
+        return _ACCEPTANCE_PARSE_ERROR
+    if data.get("source") is None:
+        data["source"] = "director"
+    return data
+
